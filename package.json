{
  "name": "ttrpg-activity",
  "private": true,
  "scripts": {
    "dev:client": "cd client && npm run dev",
    "dev:worker": "cd worker && npm run dev",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:worker\"",
    "build:client": "cd client && npm run build",
    "build:worker": "cd worker && npm run build",
    "build": "npm run build:client && npm run build:worker",
    "deploy": "cd worker && npm run deploy"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
